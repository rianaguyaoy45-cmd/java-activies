import java.util.Arrays;
import java.util.Scanner;

public class Week5ArraysMain {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int choice;
        do {
            System.out.println("\n===== WEEK 5 ARRAYS MENU =====");
            System.out.println("1 — Basic: Favorite Things Array");
            System.out.println("2 — Intermediate: Class Statistics Calculator");
            System.out.println("3 — Advanced: Search & Sort Mini‑Tool");
            System.out.println("4 — Expert: Class Ranking System");
            System.out.println("0 — Exit");
            System.out.print("Enter choice: ");
            choice = scan.nextInt();

            switch(choice) {
                case 1: runFavoriteThings(); break;
                case 2: runClassStats(); break;
                case 3: runSearchSort(); break;
                case 4: runClassRanking(); break;
                case 0: System.out.println("Exiting…"); break;
                default: System.out.println("Invalid choice!");
            }
        } while(choice != 0);
        scan.close();
    }

    static void runFavoriteThings() {
        System.out.println("\n>>> Basic: Favorite Things Array");
        String[] favorites = {"Reading","Music","Hiking","Cooking","Gaming"};
        for(int i = 0; i < favorites.length; i++) {
            System.out.println((i+1) + ". " + favorites[i]);
        }
        System.out.println("Total number of favorite things: " + favorites.length);
    }

    static void runClassStats() {
        System.out.println("\n>>> Intermediate: Class Statistics Calculator");
        int[] scores = {85, 92, 78, 90, 66, 79, 94, 81};
        int sum = 0;
        int highest = scores[0];
        int lowest = scores[0];
        for(int s : scores) {
            sum += s;
            if(s > highest) highest = s;
            if(s < lowest) lowest = s;
        }
        double average = (double)sum / scores.length;
        System.out.println("Total Sum: " + sum);
        System.out.printf("Average Score: %.2f%n", average);
        System.out.println("Highest Score: " + highest);
        System.out.println("Lowest Score: " + lowest);
    }

    static void runSearchSort() {
        System.out.println("\n>>> Advanced: Search & Sort Mini‑Tool");
        int[] scores = {85, 92, 78, 90, 66, 79, 94, 81};
        int target = 79;
        int foundIndex = -1;
        for(int i = 0; i < scores.length; i++) {
            if(scores[i] == target) {
                foundIndex = i;
                break;
            }
        }
        if(foundIndex != -1) System.out.println("Value " + target + " found at index " + foundIndex);
        else System.out.println("Value " + target + " not found");

        int[] scoresCopy = Arrays.copyOf(scores, scores.length);
        Arrays.sort(scoresCopy);
        System.out.print("Original array: ");
        for(int num : scores) System.out.print(num + " ");
        System.out.print("\nSorted copy:   ");
        for(int num : scoresCopy) System.out.print(num + " ");
        System.out.println();
    }

    static void runClassRanking() {
        System.out.println("\n>>> Expert: Class Ranking System");
        int[][] quizData = {{80,85,90,88},{92,94,91,95},{75,70,80,78},{88,90,89,91},{92,93,90,94}};
        Student[] students = {new Student("Anna",quizData[0]),new Student("Ben",quizData[1]),new Student("Cara",quizData[2]),new Student("Dave",quizData[3]),new Student("Eve",quizData[4])};
        customSortStudents(students);
        System.out.println("===== LEADERBOARD =====");
        for(int i=0;i<students.length;i++) System.out.printf("Rank %d | %‑5s | Avg: %.2f%n",(i+1),students[i].name,getAverage(students[i].quizzes));
        String searchName="Ben";
        int rank=findStudentRank(students,searchName);
        if(rank>0) System.out.println(searchName+" is at rank "+rank);
        else System.out.println(searchName+" not found");
    }

    static double getAverage(int[] quizzes) {
        int sum=0;
        for(int q:quizzes) sum+=q;
        return (double)sum/quizzes.length;
    }

    static void customSortStudents(Student[] s) {
        for(int i=0;i<s.length-1;i++) {
            for(int j=0;j<s.length-1-i;j++) {
                double avg1=getAverage(s[j].quizzes);
                double avg2=getAverage(s[j+1].quizzes);
                if(avg1<avg2) {
                    Student temp=s[j]; s[j]=s[j+1]; s[j+1]=temp;
                }
            }
        }
    }

    static int findStudentRank(Student[] s, String name) {
        for(int i=0;i<s.length;i++) {
            if(s[i].name.equalsIgnoreCase(name)) return i+1;
        }
        return -1;
    }

    static class Student {
        String name;
        int[] quizzes;
        Student(String n, int[] q) { name=n; quizzes=q; }
    }
}
