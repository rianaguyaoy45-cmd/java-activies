import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        // ==========================================
        // ACTIVITY 1: Number & Square Printer
        // ==========================================
        System.out.println("\n=== Number & Square Printer ===");

        for (int i = 1; i <= 10; i++) {
            System.out.println("Number: " + i + " | Square: " + (i * i));
        }

        System.out.println("\nChanged loop bound to 20:");

        for (int i = 1; i <= 20; i++) {
            System.out.println("Number: " + i + " | Square: " + (i * i));
        }

        // ==========================================
        // ACTIVITY 2: Sum Until Sentinel Value
        // ==========================================
        System.out.println("\n=== Sum Until Sentinel Value ===");
        System.out.println("Enter integers (-1 to stop):");

        int sum = 0;
        int number = input.nextInt();

        while (number != -1) {
            sum += number;
            number = input.nextInt();
        }

        System.out.println("Final total: " + sum);

        // ==========================================
        // ACTIVITY 3: Pattern Generator With Early Exit
        // ==========================================
        System.out.println("\n=== Pattern Generator With Early Exit ===");

        int size = 5;

        for (int i = 1; i <= size; i++) {
            for (int j = 1; j <= size; j++) {

                if (j == 4) {
                    break; // Stops the inner loop
                }

                if (i == 3 && j == 2) {
                    continue; // Skips this position
                }

                System.out.print("* ");
            }

            System.out.println();
        }

        // ==========================================
        // ACTIVITY 4: Warehouse Inventory Scanner
        // ==========================================
        System.out.println("\n=== Warehouse Inventory Scanner ===");

        int[][] warehouse = {
            {10, 5, 8},
            {7, -1, 4},
            {2, 3, 6}
        };

        boolean running = true;

        while (running) {
            System.out.println("\n1. Display Inventory");
            System.out.println("2. Total Inventory");
            System.out.println("3. Find First Low Stock Shelf");
            System.out.println("4. Restock Shelf");
            System.out.println("5. Exit");
            System.out.print("Choose: ");

            int choice = input.nextInt();

            switch (choice) {
                case 1:
                    System.out.println("Warehouse Inventory:");

                    for (int i = 0; i < warehouse.length; i++) {
                        for (int j = 0; j < warehouse[i].length; j++) {
                            if (warehouse[i][j] == -1) {
                                System.out.print("DAMAGED ");
                                continue;
                            }

                            System.out.print(warehouse[i][j] + " ");
                        }
                        System.out.println();
                    }
                    break;

                case 2:
                    int total = 0;

                    for (int i = 0; i < warehouse.length; i++) {
                        for (int j = 0; j < warehouse[i].length; j++) {
                            if (warehouse[i][j] == -1) {
                                continue;
                            }

                            total += warehouse[i][j];
                        }
                    }

                    System.out.println("Total Inventory: " + total);
                    break;

                case 3:
                    boolean found = false;

                    for (int i = 0; i < warehouse.length; i++) {
                        for (int j = 0; j < warehouse[i].length; j++) {
                            if (warehouse[i][j] == -1) {
                                continue;
                            }

                            if (warehouse[i][j] < 5) {
                                System.out.println(
                                    "Low stock shelf found at Row "
                                    + (i + 1) + ", Column " + (j + 1)
                                    + " | Items: " + warehouse[i][j]
                                );

                                found = true;
                                break; // Stops the inner loop
                            }
                        }

                        if (found) {
                            break; // Stops the outer loop
                        }
                    }

                    if (!found) {
                        System.out.println("No low stock shelf found.");
                    }
                    break;

                case 4:
                    System.out.print("Enter row (1-3): ");
                    int row = input.nextInt();

                    System.out.print("Enter column (1-3): ");
                    int col = input.nextInt();

                    if (row < 1 || row > 3 || col < 1 || col > 3) {
                        System.out.println("Invalid shelf position.");
                    } else if (warehouse[row - 1][col - 1] == -1) {
                        System.out.println("Cannot restock a damaged shelf.");
                    } else {
                        System.out.print("Enter quantity to add: ");
                        int quantity = input.nextInt();

                        if (quantity <= 0) {
                            System.out.println("Quantity must be positive.");
                        } else {
                            warehouse[row - 1][col - 1] += quantity;
                            System.out.println("Restocking successful!");
                        }
                    }
                    break;

                case 5:
                    running = false;
                    System.out.println("Exiting Warehouse Inventory Scanner.");
                    break;

                default:
                    System.out.println("Invalid choice. Try again.");
            }
        }

        input.close();
    }
}
